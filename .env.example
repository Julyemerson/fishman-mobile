# URL base da API do Fishman (obrigatória — o app não inicia sem ela).
# Use o IP do Mac na rede (ipconfig getifaddr en0), tanto no celular quanto no emulador:
# o Expo Go 58 não aceita http://10.0.2.2 nem http://localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:3000

# Número do WhatsApp do suporte, com DDI e DDD, apenas dígitos (ex.: 5511999999999)
EXPO_PUBLIC_SUPPORT_PHONE_NUMBER=
